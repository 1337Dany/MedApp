# Copy to .env and fill in. Never commit .env.

# General
ASPNETCORE_ENVIRONMENT=Development

API_HTTP_PORT=5000
# Host port of the web app (nginx). Production: 80.
FRONTEND_PORT=3000

# DB (POSTGRES_PORT is the host-side port; inside compose the API always uses 5432)
POSTGRES_DATABASE=medapp
POSTGRES_USER=medapp
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Apply pending EF migrations when the API starts. true for local dev; leave unset/false in
# production unless that deploy should migrate (take a pg_dump first).
DB_MIGRATE_ON_STARTUP=true

# JWT
JWT_ISSUER=MedApp
JWT_AUDIENCE=MedApp.Client
# At least 32 characters; generate your own, e.g. `openssl rand -base64 48`
JWT_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_CLOCK_SKEW_SECONDS=30
